# Application Insights - for end-to-end tracing
# Auto-injected in hosted containers (recommended).
# Set for local telemetry and trace collection.
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# Your Foundry model — the Copilot SDK talks to this over the Responses wire API
# using a Managed-Identity bearer token. Both are auto-injected when deployed as a
# hosted agent; set them here only for local runs (`python main.py`).
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5

# Optional locally. azd injects the deployed workiq-tools endpoint in Azure.
TOOLBOX_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/workiq-tools/mcp?api-version=v1

# Safer public default: skills and read-only file tools only.
# Set true only if you accept auto-approved shell/Python/file mutation tools.
COPILOT_ENABLE_CODE_TOOLS=false

# Logging level
LOG_LEVEL=INFO
